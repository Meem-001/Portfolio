@model PortfolioModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@Model.Name — @Model.Tagline. Portfolio: education, competitive programming, skills, projects, research and activities." />
    <title>@Model.Name · Portfolio</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%230F766E'/%3E%3Ctext x='50' y='68' font-size='52' font-family='Georgia' fill='white' text-anchor='middle'%3E@(Model.Name.Length > 0 ? Model.Name[0].ToString().ToUpper() : "P")%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header" id="siteHeader">
        <nav class="nav container" aria-label="Main navigation">
            <a class="brand" href="#top">@Model.Name.Split(' ')[0]<span class="brand-dot">.</span></a>

            <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="navMenu">
                <span></span><span></span><span></span>
            </button>

            <ul class="nav-menu" id="navMenu">
                <li><a href="#education" class="nav-link">Education</a></li>
                <li><a href="#competitive-programming" class="nav-link">Competitive&nbsp;Programming</a></li>
                <li><a href="#skills" class="nav-link">Skills</a></li>
                <li><a href="#projects" class="nav-link">Projects</a></li>
                <li><a href="#research" class="nav-link">Research</a></li>
                <li><a href="#activities" class="nav-link">Co-curricular</a></li>
                <li><a href="#contact" class="nav-link nav-cta">Contact</a></li>
            </ul>
        </nav>
    </header>

    <main id="top">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <p>© <span id="year"></span> @Model.Name · Built with ASP.NET Core MVC</p>
            <a href="#top" class="to-top" aria-label="Back to top">Back to top ↑</a>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
